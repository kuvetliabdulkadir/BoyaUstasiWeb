@model Project
@{
    ViewData["Title"] = "Yeni Proje";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h2>Yeni Proje Ekle</h2>
        <a href="@ViewBag.AdminPath/projeler" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Geri
        </a>
    </div>
    <div class="admin-card-body">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="admin-form">
            @Html.AntiForgeryToken()

            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="Title" class="form-label">Proje Başlığı *</label>
                    <input asp-for="Title" class="form-control" placeholder="örn: Nilüfer Villa Projesi" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="Category" class="form-label">Kategori (Hizmet) *</label>
                    <select asp-for="Category" class="form-select" required>
                        <option value="">Seçiniz</option>
                        @{
                            var services = ViewBag.Services as List<string> ?? new List<string>();
                        }
                        @foreach (var service in services)
                        {
                            <option value="@service">@service</option>
                        }
                    </select>
                    <small class="text-muted">Kategori, admin panelden eklenen aktif hizmetlerden seçilir.</small>
                    <span asp-validation-for="Category" class="text-danger small"></span>
                </div>

                <div class="col-12">
                    <label asp-for="Description" class="form-label">Açıklama</label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Proje hakkında kısa açıklama..."></textarea>
                </div>

                <div class="col-md-4">
                    <label asp-for="Location" class="form-label">Konum</label>
                    <input asp-for="Location" class="form-control" placeholder="örn: Nilüfer, Bursa" />
                </div>

                <div class="col-md-4">
                    <label asp-for="PaintBrand" class="form-label">Boya Markası</label>
                    <input asp-for="PaintBrand" class="form-control" placeholder="örn: Marshall" />
                </div>

                <div class="col-md-4">
                    <label asp-for="PaintColor" class="form-label">Boya Rengi</label>
                    <input asp-for="PaintColor" class="form-control" placeholder="örn: Krem Beyaz" />
                </div>

                <div class="col-md-4">
                    <label asp-for="DurationDays" class="form-label">Süre (Gün)</label>
                    <input asp-for="DurationDays" type="number" class="form-control" min="1" placeholder="örn: 5" />
                </div>

                <div class="col-md-4">
                    <label asp-for="DisplayOrder" class="form-label">Sıralama</label>
                    <input asp-for="DisplayOrder" type="number" class="form-control" min="0" value="0" />
                </div>

                <div class="col-md-4">
                    <label class="form-label d-block">Seçenekler</label>
                    <div class="form-check form-check-inline">
                        <input asp-for="IsActive" class="form-check-input" checked />
                        <label asp-for="IsActive" class="form-check-label">Aktif</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input asp-for="IsFeatured" class="form-check-input" />
                        <label asp-for="IsFeatured" class="form-check-label">Öne Çıkan</label>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Önce Fotoğrafı</label>
                    <input type="file" name="beforeImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Maksimum 5MB, JPG/PNG formatında</small>
                </div>

                <div class="col-md-6">
                    <label class="form-label">Sonra Fotoğrafı</label>
                    <input type="file" name="afterImage" class="form-control" accept="image/*" />
                    <small class="text-muted">Maksimum 5MB, JPG/PNG formatında</small>
                </div>

                @* Video Bölümü *@
                <div class="col-12 mt-4">
                    <h5 class="border-bottom pb-2">Video Ekle (Opsiyonel)</h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Video Dosyası Yükle</label>
                            <input type="file" name="videoFile" class="form-control" accept="video/mp4,video/webm" />
                            <small class="text-muted">Maksimum 50MB, MP4/WebM formatında. Kendi sunucumuza yüklenir.</small>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="VideoEmbedCode" class="form-label">Video Bağlantısı (URL)</label>
                            <input asp-for="VideoEmbedCode" class="form-control" placeholder="Örn: https://www.youtube.com/watch?v=..." />
                            <small class="text-muted">YouTube, Vimeo veya Instagram video linki yapıştırın.</small>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <hr class="my-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-2"></i>Kaydet
                    </button>
                    <a href="@ViewBag.AdminPath/projeler" class="btn btn-outline-secondary ms-2">İptal</a>
                </div>
            </div>
        </form>
    </div>
</div>
