@model List<ContactMessage>
@{
    ViewData["Title"] = "Mesajlar";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var unreadOnly = ViewBag.UnreadOnly as bool?;
}

<div class="admin-card">
    <div class="admin-card-header">
        <h2>Gelen Mesajlar</h2>
        <div class="d-flex gap-2">
            <a href="@ViewBag.AdminPath/mesajlar" class="btn btn-sm @(unreadOnly != true ? "btn-primary" : "btn-outline-primary")">
                Tümü
            </a>
            <a href="@ViewBag.AdminPath/mesajlar?unreadOnly=true" class="btn btn-sm @(unreadOnly == true ? "btn-primary" : "btn-outline-primary")">
                Okunmamış
            </a>
        </div>
    </div>
    <div class="admin-card-body p-0">
        @if (Model.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Ad Soyad</th>
                        <th class="d-none d-md-table-cell">Telefon</th>
                        <th class="d-none d-lg-table-cell">İl</th>
                        <th class="d-none d-lg-table-cell">İlçe</th>
                        <th class="d-none d-lg-table-cell">Hizmet</th>
                        <th class="d-none d-lg-table-cell">Tarih</th>
                        <th>Durum</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        // Resim dosyaları
                        var msgAttachmentFileNames = new List<string>();
                        if (!string.IsNullOrEmpty(msg.AttachmentPaths))
                        {
                            try
                            {
                                msgAttachmentFileNames = System.Text.Json.JsonSerializer.Deserialize<List<string>>(msg.AttachmentPaths) ?? new List<string>();
                            }
                            catch { }
                        }
                        
                        <tr class="@(!msg.IsRead ? "table-warning" : "")">
                            <td>
                                <a href="@ViewBag.AdminPath/mesajlar/detay/@msg.Id">
                                    <strong>@(msg.FullName ?? "-")</strong>
                                </a>
                                @if (!string.IsNullOrEmpty(msg.Email))
                                {
                                    <br><small class="text-muted">@msg.Email</small>
                                }
                                @if (msgAttachmentFileNames.Any())
                                {
                                    <br>
                                    <a href="javascript:void(0);" 
                                       onclick="openImageModal(@msg.Id, 0)" 
                                       class="text-decoration-none"
                                       title="@(msgAttachmentFileNames.Count > 1 ? $"{msgAttachmentFileNames.Count} fotoğraf - Tıklayarak görüntüle" : "Fotoğrafı büyüt")">
                                        <img src="@msgAttachmentFileNames[0]" 
                                             alt="Fotoğraf" 
                                             class="message-thumbnail" 
                                             style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px; cursor: pointer; border: 1px solid #ddd;" />
                                        <small class="text-muted ms-1">
                                            <i class="bi bi-image"></i>
                                            @if (msgAttachmentFileNames.Count > 1)
                                            {
                                                <span class="badge bg-secondary">+@(msgAttachmentFileNames.Count - 1)</span>
                                            }
                                        </small>
                                    </a>
                                }
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (!string.IsNullOrEmpty(msg.Phone))
                                {
                                    <a href="tel:@msg.Phone">@msg.Phone</a>
                                }
                                else
                                {
                                    <span>-</span>
                                }
                            </td>
                            <td class="d-none d-lg-table-cell">@(msg.City ?? "-")</td>
                            <td class="d-none d-lg-table-cell">@(msg.District ?? "-")</td>
                            <td class="d-none d-lg-table-cell">@(msg.ServiceType ?? "-")</td>
                            <td class="d-none d-lg-table-cell">
                                <span data-utc-date="@msg.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss.fffZ")">@msg.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
                            </td>
                            <td>
                                <span class="status-badge @(msg.IsRead ? "active" : "unread")">
                                    @(msg.IsRead ? "Okundu" : "Yeni")
                                </span>
                            </td>
                            <td>
                                <div class="action-btns">
                                    @if (msgAttachmentFileNames.Any())
                                    {
                                        <a href="javascript:void(0);" 
                                           onclick="openImageModal(@msg.Id, 0)" 
                                           class="btn-action" 
                                           title="@(msgAttachmentFileNames.Count > 1 ? $"{msgAttachmentFileNames.Count} fotoğraf var" : "Fotoğrafı Görüntüle")"
                                           style="color: #0d6efd;">
                                            <i class="bi bi-image"></i>
                                            @if (msgAttachmentFileNames.Count > 1)
                                            {
                                                <span class="badge bg-secondary" style="font-size: 0.6rem;">@msgAttachmentFileNames.Count</span>
                                            }
                                        </a>
                                    }
                                    <a href="@ViewBag.AdminPath/mesajlar/detay/@msg.Id" class="btn-action" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (!string.IsNullOrEmpty(msg.Phone))
                                    {
                                        <a href="https://wa.me/@msg.Phone.Replace(" ", "").Replace("+", "")" target="_blank" class="btn-action" title="WhatsApp'tan Yanıtla" style="color: #25D366;">
                                            <i class="bi bi-whatsapp"></i>
                                        </a>
                                    }
                                    <form asp-action="Delete" asp-route-id="@msg.Id" method="post" class="d-inline" onsubmit="return confirm('Bu mesajı silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn-action delete" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            
            <script>
                // Resim URLleri
                window.allMessagesImages = {};
                @foreach (var msg in Model)
                {
                    var msgImages = new List<string>();
                    if (!string.IsNullOrEmpty(msg.AttachmentPaths))
                    {
                        try
                        {
                            var paths = System.Text.Json.JsonSerializer.Deserialize<List<string>>(msg.AttachmentPaths) ?? new List<string>();
                            foreach (var path in paths)
                            {
                                msgImages.Add(path);
                            }
                        }
                        catch { }
                    }
                    if (msgImages.Any())
                    {
                        <text>
                        window.allMessagesImages[@msg.Id] = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(msgImages));
                        </text>
                    }
                }
            </script>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-envelope-open"></i>
                <p>@(unreadOnly == true ? "Okunmamış mesaj yok" : "Henüz mesaj yok")</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tarih formatı
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('[data-utc-date]').forEach(function(element) {
                const utcDate = element.getAttribute('data-utc-date');
                const date = new Date(utcDate);
                
                const day = String(date.getDate()).padStart(2, '0');
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const year = date.getFullYear();
                const hours = String(date.getHours()).padStart(2, '0');
                const minutes = String(date.getMinutes()).padStart(2, '0');
                
                element.textContent = `${day}.${month}.${year} ${hours}:${minutes}`;
            });
        });

        // Modal tetikleme fonksiyonu (Listeden)
        function openImageModal(messageId, imageIndex) {
            if (window.allMessagesImages && window.allMessagesImages[messageId]) {
                const images = window.allMessagesImages[messageId];
                showImageModal(images, imageIndex || 0);
            }
        }
    </script>
}

