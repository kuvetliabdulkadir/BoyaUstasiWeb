@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="mb-4">
                <i class="bi bi-exclamation-triangle text-warning display-1"></i>
            </div>
            
            <h1 class="display-5 fw-bold mb-3 text-danger">Bir Hata Oluştu</h1>
            <p class="lead text-muted mb-4">
                İsteğiniz işlenirken beklenmedik bir durumla karşılaştık. Lütfen daha sonra tekrar deneyin veya bizimle iletişime geçin.
            </p>

            @{
                var requestId = Model?.RequestId ?? Context?.TraceIdentifier;
                var showRequestId = !string.IsNullOrWhiteSpace(requestId);
            }

            @if (showRequestId)
            {
                <div class="alert alert-light border d-inline-block mb-4">
                    <small class="text-muted d-block">Destek Talep Kodu:</small>
                    <code class="fw-bold">@requestId</code>
                </div>
            }
            
            <div class="d-flex justify-content-center gap-3">
                <a href="/" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-house-door me-2"></i>Ana Sayfaya Dön
                </a>
                <a href="/iletisim" class="btn btn-outline-secondary px-4 py-2">
                    <i class="bi bi-envelope me-2"></i>İletişime Geç
                </a>
            </div>
        </div>
    </div>
</div>

