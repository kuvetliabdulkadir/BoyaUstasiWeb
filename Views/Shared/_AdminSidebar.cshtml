@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string ActiveIfController(string controller) => currentController == controller ? "active" : "";
    string ActiveIfAction(string action) => currentAction == action && currentController == "AdminSettings" ? "active" : "";
}
        @* Kenar Menü *@
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="sidebar-header">
                <a href="/usta-panel-2024" class="sidebar-brand">
                    <i class="bi bi-brush-fill"></i>
                    <span>Boya Ustası</span>
                </a>
            </div>
            
            <nav class="sidebar-nav">
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("Dashboard")" href="/usta-panel-2024">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminProjects")" href="/usta-panel-2024/projeler">
                            <i class="bi bi-images"></i>
                            <span>Projeler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminReviews")" href="/usta-panel-2024/yorumlar">
                            <i class="bi bi-chat-quote"></i>
                            <span>Yorumlar</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminMessages")" href="/usta-panel-2024/mesajlar">
                            <i class="bi bi-envelope"></i>
                            <span>Mesajlar</span>
                            @{
                                var unreadCount = ViewBag.UnreadMessageCount ?? 0;
                            }
                            @if (unreadCount > 0)
                            {
                                <span class="badge bg-danger ms-auto">@unreadCount</span>
                            }
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminServices")" href="/usta-panel-2024/hizmetler">
                            <i class="bi bi-tools"></i>
                            <span>Hizmetler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminFaq")" href="/usta-panel-2024/sss">
                            <i class="bi bi-question-circle"></i>
                            <span>SSS</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminColors")" href="/usta-panel-2024/renkler">
                            <i class="bi bi-palette"></i>
                            <span>Renk Paleti</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @ActiveIfController("AdminStatistics")" href="/usta-panel-2024/istatistikler">
                            <i class="bi bi-bar-chart-line"></i>
                            <span>İstatistikler</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <div class="nav-link small fw-bold text-uppercase" style="padding-top: 1rem; padding-bottom: 0.5rem; color: rgba(255, 255, 255, 0.5);">
                            <span>Ayarlar</span>
                        </div>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminSettings" && currentAction == "Index" ? "active" : "")" href="/usta-panel-2024/ayarlar">
                            <i class="bi bi-list-ul"></i>
                            <span>Site Ayarları</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminContactSettings" ? "active" : "")" href="/usta-panel-2024/ayarlar/iletisim">
                            <i class="bi bi-telephone"></i>
                            <span>İletişim</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminHomeSettings" ? "active" : "")" href="/usta-panel-2024/ayarlar/ana-sayfa">
                            <i class="bi bi-house"></i>
                            <span>Ana Sayfa</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminAboutSettings" ? "active" : "")" href="/usta-panel-2024/ayarlar/hakkimizda">
                            <i class="bi bi-info-circle"></i>
                            <span>Hakkımızda</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminSettings" && currentAction == "Social" ? "active" : "")" href="/usta-panel-2024/ayarlar/sosyal">
                            <i class="bi bi-share"></i>
                            <span>Sosyal Medya</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminSeoSettings" ? "active" : "")" href="/usta-panel-2024/ayarlar/seo">
                            <i class="bi bi-search"></i>
                            <span>SEO</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(currentController == "AdminSettings" && currentAction == "Assets" ? "active" : "")" href="/usta-panel-2024/ayarlar/gorseller">
                            <i class="bi bi-image"></i>
                            <span>Görseller</span>
                        </a>
                    </li>
                </ul>
            </nav>
            
            <div class="sidebar-footer">
                <a href="/" target="_blank" class="btn btn-outline-light btn-sm w-100 mb-2">
                    <i class="bi bi-box-arrow-up-right me-2"></i>Siteyi Görüntüle
                </a>
                <form asp-controller="Account" asp-action="Logout" asp-area="" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger btn-sm w-100">
                        <i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap
                    </button>
                </form>
            </div>
        </aside>
