@model List<Project>
@{
    ViewData["Title"] = "Projelerimiz";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var selectedCategory = ViewBag.SelectedCategory as string;
}

@* Sayfa Başlığı *@
<section class="page-header">
    <div class="container">
        <div class="page-header-content text-center">
            <h1 class="fade-in">Projelerimiz</h1>
            <p class="fade-in">@Html.Raw(ViewBag.ProjectsPageHeaderSubtitle)</p>
            <nav aria-label="breadcrumb" class="fade-in">
                <ol class="breadcrumb justify-content-center">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Ana Sayfa</a></li>
                    <li class="breadcrumb-item active">Projeler</li>
                </ol>
            </nav>
        </div>
    </div>
</section>

@* Projeler Bölümü *@
<section class="projects-section">
    <div class="container">
        @* Filtreleme Butonları *@
        @if (Model.Any() || (categories != null && categories.Any()))
        {
            <div class="project-filters fade-in">
                <a asp-action="Index" class="filter-btn @(string.IsNullOrEmpty(selectedCategory) ? "active" : "")">
                    Tümü
                </a>
                @foreach (var category in categories)
                {
                    <a asp-action="Index" asp-route-category="@category" class="filter-btn @(selectedCategory == category ? "active" : "")">
                        @Html.Raw(category)
                    </a>
                }
            </div>
        }

        @if (Model.Any())
        {
            <div class="row g-4 stagger-container">
                @foreach (var project in Model)
                {
                    <div class="col-md-6 col-lg-4">
                        <a class="project-link" asp-route="project-detail" asp-route-slug="@project.Slug">
                        <div class="project-card fade-in hover-lift">
                            <div class="project-image">
                                @if (!string.IsNullOrEmpty(project.AfterImagePath))
                                {
                                    <img src="@project.AfterImagePath" alt="@Html.Raw(project.Title)" loading="lazy" />
                                }
                                else
                                {
                                    <div class="project-placeholder">
                                        <i class="fas fa-paint-roller" style="font-size: 3rem;"></i>
                                    </div>
                                }
                                <div class="project-overlay">
                                    <span class="project-category">@Html.Raw(project.Category)</span>
                                </div>
                            </div>
                            <div class="project-content">
                                <h3>@Html.Raw(project.Title)</h3>
                                @if (!string.IsNullOrEmpty(project.Location))
                                {
                                    <p class="project-location">
                                        <i class="bi bi-geo-alt-fill me-1"></i>@Html.Raw(project.Location)
                                    </p>
                                }
                                <div class="project-meta">
                                    @if (!string.IsNullOrEmpty(project.PaintColor))
                                    {
                                        <span><i class="bi bi-palette me-1"></i>@Html.Raw(project.PaintColor)</span>
                                    }
                                    @if (project.DurationDays.HasValue)
                                    {
                                        <span><i class="bi bi-clock me-1"></i>@project.DurationDays gün</span>
                                    }
                                </div>
                            </div>
                        </div>
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-folder-x display-1 text-muted"></i>
                <h3 class="mt-3">Henüz proje eklenmemiş</h3>
                <p class="text-muted">Yakında projelerimizi burada görebileceksiniz.</p>
            </div>
        }
    </div>
</section>

@* Çağrı (CTA) Bölümü *@
<section class="projects-cta-section">
    <div class="container">
        <div class="projects-cta-wrapper fade-in text-center">
            <h2>@Html.Raw(ViewBag.ProjectsCtaTitle)</h2>
            <p>@Html.Raw(ViewBag.ProjectsCtaDescription)</p>
            <a asp-controller="Contact" asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="bi bi-calendar-check me-2"></i>Bilgi Almak İçin Tıklayın
            </a>
        </div>
    </div>
</section>

@section Styles {
    <link rel="stylesheet" href="~/css/projects.css" asp-append-version="true" />
}
