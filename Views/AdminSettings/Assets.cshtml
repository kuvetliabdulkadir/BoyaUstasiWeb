@model List<boya_usta_web.Models.SiteSetting>
@using System.IO
@{
    ViewData["Title"] = "Görseller";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var logo = Model.FirstOrDefault(x => x.Key == "LogoPath")?.Value ?? "";
    var ogImage = Model.FirstOrDefault(x => x.Key == "OgImagePath")?.Value ?? "";
    var simulatorImage = Model.FirstOrDefault(x => x.Key == "SimulatorImagePath")?.Value ?? "";
}

<div class="d-flex align-items-center justify-content-between mb-3">
    <h2 class="mb-0">Site Görselleri</h2>
    <a class="btn btn-outline-secondary" href="@ViewBag.AdminPath/ayarlar">Ayarlar</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Logo</h5>
                    <p class="text-muted small mb-2">
                        <strong>Format:</strong> PNG, SVG, JPG, JPEG<br/>
                        <strong>Boyut:</strong> Maksimum 2MB<br/>
                        <strong>Önerilen Logo Boyutu:</strong> 300x300px veya daha büyük (kare veya yuvarlak)<br/>
                        <strong>Öneri:</strong> PNG/SVG (şeffaf arka plan)
                    </p>
                    <div class="mb-2 d-flex align-items-center justify-content-center" style="margin: 0 auto; min-height: 250px;">
                        @if (!string.IsNullOrEmpty(logo))
                        {
                            <img src="@logo" alt="Logo" style="max-width: 300px; max-height: 300px; width: auto; height: auto; object-fit: contain; display: block;" />
                        }
                        else
                        {
                            <i class="fas fa-paint-roller" style="font-size: 4rem; color: #6c757d;"></i>
                        }
                    </div>
                    <input class="form-control" type="file" name="logo" accept="image/png,image/svg+xml,image/jpeg,image/jpg" />
                    <div class="text-muted small mt-2">Mevcut: <code>@logo</code></div>
                    @if (!string.IsNullOrEmpty(logo))
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteLogo()">
                                <i class="bi bi-trash me-1"></i>Logoyu Kaldır
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Favicon</h5>
                    <p class="text-muted small mb-2">
                        <strong>Otomatik:</strong> Logo otomatik olarak favicon olarak kullanılır<br/>
                        <strong>Not:</strong> Logo yüklediğinizde favicon da güncellenir
                    </p>
                    <div class="mb-2 border rounded p-2 bg-light" style="min-height: 48px; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(logo))
                        {
                            <img src="@logo" alt="Favicon (Logo)" style="width:48px;height:48px;object-fit:contain;" />
                        }
                        else
                        {
                            <span class="text-muted">Logo yok (Favicon da yok)</span>
                        }
                    </div>
                    <div class="alert alert-info mb-0">
                        <i class="bi bi-info-circle me-2"></i>Favicon, logodan otomatik olarak alınır. Logo yüklediğinizde favicon da güncellenir.
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">OG (Sosyal Paylaşım) Görseli</h5>
                    <p class="text-muted small mb-2">
                        <strong>Format:</strong> JPG, PNG, WebP<br/>
                        <strong>Boyut:</strong> Maksimum 5MB<br/>
                        <strong>Öneri:</strong> 1200x630 piksel (1.91:1 oran)
                    </p>
                    <div class="mb-2 border rounded p-2 bg-light" style="min-height: 120px; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(ogImage))
                        {
                            <img src="@ogImage" alt="OG image" style="max-width:100%;max-height:120px;object-fit:cover;border-radius:8px;" />
                        }
                        else
                        {
                            <i class="fas fa-paint-roller" style="font-size: 3rem; color: #6c757d;"></i>
                        }
                    </div>
                    <input class="form-control" type="file" name="ogImage" accept="image/jpeg,image/png,image/webp" />
                    <div class="text-muted small mt-2">Mevcut: <code>@ogImage</code></div>
                    @if (!string.IsNullOrEmpty(ogImage))
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteOgImage()">
                                <i class="bi bi-trash me-1"></i>Görseli Kaldır
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Renk Simülatörü Görseli</h5>
                    <p class="text-muted small mb-2">
                        <strong>Format:</strong> PNG, JPG, JPEG, WebP<br/>
                        <strong>Boyut:</strong> Maksimum 5MB<br/>
                        <strong>Öneri:</strong> Yüksek kaliteli görsel dosyası
                    </p>
                    <div class="mb-2 border rounded p-2 bg-light" style="min-height: 120px; display: flex; align-items: center; justify-content: center;">
                        @if (!string.IsNullOrEmpty(simulatorImage))
                        {
                            <img src="@simulatorImage" alt="Simülatör Görseli" style="max-width:100%;max-height:120px;object-fit:contain;" />
                        }
                        else
                        {
                            <i class="fas fa-paint-roller" style="font-size: 3rem; color: #6c757d;"></i>
                        }
                    </div>
                    <input class="form-control" type="file" name="simulatorImage" accept="image/jpeg,image/png,image/webp" />
                    <div class="text-muted small mt-2">Mevcut: <code>@(string.IsNullOrEmpty(simulatorImage) ? "Yok" : simulatorImage)</code></div>
                    @if (!string.IsNullOrEmpty(simulatorImage))
                    {
                        <div class="mt-2">
                            <button type="button" class="btn btn-outline-danger btn-sm" onclick="deleteSimulatorImage()">
                                <i class="bi bi-trash me-1"></i>Görseli Kaldır
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" type="submit">Kaydet</button>
        <button type="button" class="btn btn-outline-warning" onclick="cleanupUnusedFiles()">
            <i class="bi bi-trash me-1"></i>Kullanılmayan Dosyaları Temizle
        </button>
        <button type="button" class="btn btn-outline-info" onclick="testPermissions()">
            <i class="bi bi-shield-lock me-1"></i>İzinleri Test Et
        </button>
    </div>
</form>

<script>
    function deleteLogo() {
        if (confirm('Logoyu kaldırmak istediğinize emin misiniz?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@ViewBag.AdminPath/ayarlar/gorseller/logo-sil';
            
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
            
            document.body.appendChild(form);
            form.submit();
        }
    }

    function deleteOgImage() {
        if (confirm('OG görselini kaldırmak istediğinize emin misiniz?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@ViewBag.AdminPath/ayarlar/gorseller/og-image-sil';
            
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
            
            document.body.appendChild(form);
            form.submit();
        }
    }

    function deleteSimulatorImage() {
        if (confirm('Simülatör görselini kaldırmak istediğinize emin misiniz?')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@ViewBag.AdminPath/ayarlar/gorseller/simulator-sil';
            
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
            
            document.body.appendChild(form);
            form.submit();
        }
    }

    function cleanupUnusedFiles() {
        if (confirm('Kullanılmayan dosyaları temizlemek istediğinize emin misiniz?\n\nBu işlem veritabanında referans edilmeyen tüm dosyaları silecektir. Bu işlem geri alınamaz!')) {
            var form = document.createElement('form');
            form.method = 'POST';
            form.action = '@ViewBag.AdminPath/ayarlar/temizle-kullanilmayan-dosyalar';
            
            var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            var tokenInput = document.createElement('input');
            tokenInput.type = 'hidden';
            tokenInput.name = '__RequestVerificationToken';
            tokenInput.value = token;
            form.appendChild(tokenInput);
            
            document.body.appendChild(form);
            form.submit();
        }
    }

    function testPermissions() {
        var form = document.createElement('form');
        form.method = 'POST';
        form.action = '@ViewBag.AdminPath/ayarlar/izin-testi';
        
        var token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var tokenInput = document.createElement('input');
        tokenInput.type = 'hidden';
        tokenInput.name = '__RequestVerificationToken';
        tokenInput.value = token;
        form.appendChild(tokenInput);
        
        document.body.appendChild(form);
        form.submit();
    }
</script>
