@model boya_usta_web.Models.ViewModels.HomeSettingsVm

<div class="col-12">
    <h5 class="border-bottom pb-2 mb-3 mt-4">Neden Biz Bölümü</h5>
</div>
<div class="col-12">
    <label asp-for="WhyUsSubtitle" class="form-label"></label>
    <input asp-for="WhyUsSubtitle" class="form-control" placeholder="{years} yıllık tecrübemizle..." />
    <div class="text-muted small mt-1">{years} yazarsanız tecrübe yılı otomatik eklenecektir.</div>
    <span asp-validation-for="WhyUsSubtitle" class="text-danger"></span>
</div>
<div class="col-12">
    <label asp-for="WhyUsTitle" class="form-label"></label>
    <input asp-for="WhyUsTitle" class="form-control" />
    <span asp-validation-for="WhyUsTitle" class="text-danger"></span>
</div>
<div class="col-12">
    <label asp-for="WhyUsExperienceDescription" class="form-label"></label>
    <textarea asp-for="WhyUsExperienceDescription" class="form-control" rows="2" placeholder="{years} yıllık tecrübemizle..."></textarea>
    <div class="text-muted small mt-1">{years} yazarsanız tecrübe yılı otomatik eklenecektir.</div>
    <span asp-validation-for="WhyUsExperienceDescription" class="text-danger"></span>
</div>

@* Card 1 *@
<div class="col-12">
    <div class="card border mb-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h6 class="text-primary mb-0">Kart 1</h6>
            <div class="d-flex gap-2 align-items-center">
                <div class="form-check form-switch mb-0">
                    <input asp-for="WhyUsCard1IsActive" class="form-check-input" type="checkbox" id="card1Active" />
                    <label class="form-check-label" for="card1Active">Aktif</label>
                </div>

            </div>
        </div>
        <div class="card-body">
            <div class="col-md-6">
                <label asp-for="WhyUsCard1Title" class="form-label">Başlık</label>
                <input asp-for="WhyUsCard1Title" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="WhyUsCard1Icon" class="form-label">İkon</label>
                <div class="row g-2 align-items-end">
                    <div class="col-8">
                        <select asp-for="WhyUsCard1Icon" class="form-select icon-select" data-preview-id="preview-WhyUsCard1Icon" data-initial-value="@(Model.WhyUsCard1Icon ?? "")">
                            <partial name="_IconSelectOptions" />
                            </select>
                        </div>
                    <div class="col-4">
                        <div class="border rounded d-flex align-items-center justify-content-center" style="height: 38px; background: #fff;">
                            <i id="preview-WhyUsCard1Icon" class="@(Model.WhyUsCard1Icon ?? "bi bi-stars")" style="font-size: 1.4rem;"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <label asp-for="WhyUsCard1Desc" class="form-label">Açıklama</label>
                <textarea asp-for="WhyUsCard1Desc" class="form-control" rows="2" placeholder="{years} yıllık tecrübe ile..."></textarea>
                <div class="text-muted small mt-1">{years} yazarsanız tecrübe yılı otomatik eklenecektir.</div>
            </div>
        </div>
    </div>
</div>

