@model boya_usta_web.Models.ViewModels.AboutSettingsVm

<div class="col-12">
    <h5 class="border-bottom pb-2 mb-3 mt-4">Hikayemiz Bölümü</h5>
</div>
<div class="col-md-4">
    <label class="form-label">İkon / Resim</label>
    <div class="row g-2 align-items-end">
        <div class="col-8">
            <select asp-for="AboutImageIcon" class="form-select icon-select" data-preview-id="about-image-preview" data-initial-value="@(Model.AboutImageIcon ?? "bi bi-brush-fill")">
                <partial name="_IconSelectOptions" />
            </select>
        </div>
        <div class="col-4">
            <div class="border rounded d-flex align-items-center justify-content-center" style="height: 38px; background: #fff; position: relative;" id="about-image-preview-container">
                @if (!string.IsNullOrEmpty(Model.AboutImagePath))
                {
                    <img src="@Model.AboutImagePath" alt="Resim" id="about-image-preview-img" style="max-width: 100%; max-height: 100%; object-fit: contain; display: block;" />
                    <i id="about-image-preview" class="@(Model.AboutImageIcon ?? "bi bi-brush-fill")" style="font-size: 1.4rem; display: none;"></i>
                }
                else
                {
                    <img src="" alt="Resim" id="about-image-preview-img" style="max-width: 100%; max-height: 100%; object-fit: contain; display: none;" />
                    <i id="about-image-preview" class="@(Model.AboutImageIcon ?? "bi bi-brush-fill")" style="font-size: 1.4rem; display: block;"></i>
                }
            </div>
        </div>
    </div>
</div>
<div class="col-md-8">
    <label class="form-label">Resim Yükle</label>
    <input type="file" name="AboutImage" class="form-control" accept="image/*" onchange="handleAboutImageChange(this)" />
    <div class="text-muted small mt-1">Resim yüklerseniz ikon yerine resim gösterilir. Resim yoksa ikon kullanılır.</div>
    @if (!string.IsNullOrEmpty(Model.AboutImagePath))
    {
        <div class="mt-2">
            <button type="button" class="btn btn-sm btn-danger" onclick="removeAboutImage()">
                <i class="bi bi-trash me-1"></i>Resmi Kaldır
            </button>
        </div>
    }
    <input type="hidden" asp-for="AboutImagePath" id="about-image-path-input" />
</div>
