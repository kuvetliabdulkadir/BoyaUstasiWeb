    // Form submit edilmeden önce hem özellikleri hem değerleri yeniden indexle
    document.querySelector('form').addEventListener('submit', function(e) {
        // Önce reindex yap
        reindexFeatures();
        reindexValues();
        
        // Tüm icon-select'lerin value'larını kontrol et (değer kartları için)
        document.querySelectorAll('.value-card select.icon-select').forEach(function(select) {
            const currentValue = select.value ? select.value.trim() : '';
            const dataInitialValue = (select.getAttribute('data-initial-value') || '').trim();
            
            // Hangi değeri kullanacağımızı belirle (data-initial-value öncelikli)
            const valueToUse = dataInitialValue || currentValue;
            
            if (valueToUse) {
                // Option'ı bul (case-insensitive)
                let option = Array.from(select.options).find(o => {
                    const optValue = (o.value || '').trim();
                    return optValue === valueToUse;
                });
                
                // Case-insensitive arama
                if (!option) {
                    option = Array.from(select.options).find(o => {
                        const optValue = (o.value || '').trim();
                        return optValue.toLowerCase() === valueToUse.toLowerCase();
                    });
                }
                
                if (option) {
                    // Option bulundu, seçili yap
                    Array.from(select.options).forEach(o => {
                        o.selected = false;
                        o.removeAttribute('selected');
                    });
                    option.selected = true;
                    option.setAttribute('selected', 'selected');
                    select.value = valueToUse;
                    select.selectedIndex = Array.from(select.options).indexOf(option);
                } else {
                    // Option bulunamadı, özel değer olarak ekle
                    const opt = document.createElement('option');
                    opt.value = valueToUse;
                    opt.textContent = 'Mevcut (özel): ' + valueToUse;
                    opt.selected = true;
                    opt.setAttribute('selected', 'selected');
                    select.insertBefore(opt, select.firstChild);
                    select.value = valueToUse;
                    select.selectedIndex = 0;
                }
            }
        });
    });
</script>
