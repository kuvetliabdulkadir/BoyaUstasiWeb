@model boya_usta_web.Models.ViewModels.ContactSettingsVm

<div class="col-12">
    <label asp-for="WorkingHours" class="form-label">Çalışma Saatleri</label>
    <div class="card border">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label small fw-bold">Hafta Günleri</label>
                <div class="d-flex flex-wrap gap-3">
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Pazartesi" id="day1">
                        <label class="form-check-label" for="day1">Pazartesi</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Salı" id="day2">
                        <label class="form-check-label" for="day2">Salı</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Çarşamba" id="day3">
                        <label class="form-check-label" for="day3">Çarşamba</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Perşembe" id="day4">
                        <label class="form-check-label" for="day4">Perşembe</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Cuma" id="day5">
                        <label class="form-check-label" for="day5">Cuma</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Cumartesi" id="day6">
                        <label class="form-check-label" for="day6">Cumartesi</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input working-day" type="checkbox" value="Pazar" id="day7">
                        <label class="form-check-label" for="day7">Pazar</label>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Başlangıç Saati</label>
                    <input type="text" class="form-control flatpickr-time" id="startTime" placeholder="08:00" data-required="false" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold">Bitiş Saati</label>
                    <input type="text" class="form-control flatpickr-time" id="endTime" placeholder="19:00" data-required="false" />
                </div>
            </div>
            <div class="mt-3">
                <label class="form-label small fw-bold">Sonuç (Otomatik Oluşturulur)</label>
                <input asp-for="WorkingHours" type="text" class="form-control" id="workingHoursResult" readonly placeholder="Seçimleriniz buraya otomatik yazılacak" />
                <div class="text-muted small mt-1">Bu alan otomatik doldurulur. İsterseniz manuel olarak da düzenleyebilirsiniz.</div>
            </div>
        </div>
    </div>
    <span asp-validation-for="WorkingHours" class="text-danger"></span>
</div>
