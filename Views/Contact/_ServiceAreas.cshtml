@using boya_usta_web.Helpers
@{
    var settings = ViewBag.Settings as Dictionary<string, string?> ?? new Dictionary<string, string?>();
    var cities = ViewBag.Cities as List<string> ?? new List<string>();
    
    // Helper kullanarak il-ilçe mapping'i al
    var cityDistrictsMap = CityDistrictsHelper.GetCityDistrictsMap(settings, cities);
    var serviceAreasList = CityDistrictsHelper.GetAllDistrictsAsList(cityDistrictsMap);
}

<div class="service-areas-card mt-4">
    <h4><i class="bi bi-geo me-2"></i>Hizmet Bölgelerimiz</h4>
    @if (serviceAreasList.Any())
    {
        <div class="service-areas-grid">
            @foreach (var area in serviceAreasList)
            {
                <div class="area-item">@area</div>
            }
        </div>
    }
    else
    {
        <p>Hizmet bölgeleri belirtilmemiş</p>
    }
</div>

