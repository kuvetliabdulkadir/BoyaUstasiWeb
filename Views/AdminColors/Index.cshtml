@model List<ColorPalette>
@{
    ViewData["Title"] = "Renk Paleti";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-card">
    <div class="admin-card-header">
        <h2>Renk Paleti</h2>
        <a class="btn btn-primary" href="@ViewBag.AdminPath/renkler/ekle">
            <i class="bi bi-plus-lg me-2"></i>Yeni Renk
        </a>
    </div>
    <div class="admin-card-body p-0">
        @Html.AntiForgeryToken()
        @if (Model.Any())
        {
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">Sıra</th>
                        <th>Renk</th>
                        <th>Ad</th>
                        <th>HEX</th>
                        <th>Kategori</th>
                        <th>Durum</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var orderedColors = Model.OrderBy(c => c.Category).ThenBy(c => c.DisplayOrder).ToList(); int colorIndex = 0; }
                    @foreach (var c in orderedColors)
                    {
                        <tr data-item-id="@c.Id" data-display-order="@c.DisplayOrder">
                            <td>
                                @{
                                    ViewData["ItemId"] = c.Id;
                                    ViewData["UpdateOrderUrl"] = $"{ViewBag.AdminPath}/renkler/sira-guncelle";
                                    ViewData["IsFirst"] = colorIndex == 0;
                                    ViewData["IsLast"] = colorIndex == orderedColors.Count - 1;
                                }
                                <partial name="_AdminTableSortButtons" view-data="ViewData" />
                            </td>
                            <td>
                                <span style="display:inline-block;width:24px;height:24px;border-radius:6px;background:@c.HexCode;border:1px solid #e2e8f0;"></span>
                            </td>
                            <td><strong>@c.Name</strong></td>
                            <td><code>@c.HexCode</code></td>
                            <td>@c.Category</td>
                            <td>
                                @{
                                    ViewData["IsActive"] = c.IsActive;
                                    ViewData["ItemId"] = c.Id;
                                    ViewData["ToggleUrl"] = $"{ViewBag.AdminPath}/renkler/aktif-pasif/{c.Id}";
                                    ViewData["EntityName"] = "Renk";
                                }
                                <partial name="_AdminStatusBadge" view-data="ViewData" />
                            </td>
                            <td>
                                @{
                                    ViewData["EditUrl"] = $"{ViewBag.AdminPath}/renkler/duzenle/{c.Id}";
                                    ViewData["DeleteUrl"] = $"{ViewBag.AdminPath}/renkler/sil/{c.Id}";
                                    ViewData["EntityName"] = "Renk";
                                }
                                <partial name="_AdminTableRowActions" view-data="ViewData" />
                            </td>
                        </tr>
                        colorIndex++;
                    }
                </tbody>
            </table>
        }
        else
        {
            {
                ViewData["Icon"] = "bi-palette";
                ViewData["Message"] = "Henüz renk yok";
            }
            <partial name="_AdminEmptyState" view-data="ViewData" />
        }
    </div>
</div>


